  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d0632a5e3ec8c049ba2104a49cd7fa6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryManager
  StoryText: {fileID: 2340429845045923627}
  unlockHintColor: {r: 1, g: 0.92156863, b: 0.015686275, a: 1}
  storySections:
  - CollectibleRequirement: 0
    TextContent: Vesna Vulovic
  - CollectibleRequirement: 5
    TextContent: ' was a Serbian flight attendant '
  - CollectibleRequirement: 30
    TextContent: "\r\nwho survied the highest fall without a parachute \r\never recorded. "
  - CollectibleRequirement: 50
    TextContent: "\r\nOn 26 January 1972\r\nshe was the sole survivor of JAT Flight
      367\r\nwhich broke up mid-air after an explosion over Czechoslovakia;\r\n She
      fell from about"
  - CollectibleRequirement: 100
    TextContent: "\r\n ~10,160m ~"
  - CollectibleRequirement: 150
    TextContent: '

      she suffered severe injuries but remarkably recovered.'
  - CollectibleRequirement: 300
    TextContent: "\r\n later becoming a Guinness World Records holder. "
  - CollectibleRequirement: 500
    TextContent: '

      She died in 2016 at age 66.'
